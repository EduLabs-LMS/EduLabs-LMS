# EduLabs live classes: settings for docker-jitsi-meet stable-11248-3.
#
# Copy to /etc/edulabs/jitsi.env (root:root, mode 0600). Never commit the real file. The four secrets at the end are
# generated on the server by the runbook (docs/ai/ONLINE_CLASS_RUNBOOK.md, step 4); everything else is fixed here.
# Replace the three CHANGE_ME values (meet host, TURN host, public IP) before the first start.
#
# Each line is plain KEY=value with no quotes: Docker Compose reads it with --env-file, and the helper scripts read single
# keys from it with grep (never by sourcing it), so a value may contain spaces (CSP_HEADER does).

# ---------------------------------------------------------------- versions and paths
JITSI_IMAGE_REPO=ghcr.io/jitsi
JITSI_IMAGE_VERSION=stable-11248-3
RESTART_POLICY=unless-stopped
CONFIG=/srv/jitsi/cfg
TZ=Africa/Cairo

# ---------------------------------------------------------------- hostnames and addresses (CHANGE_ME)
# The Cloudflare-proxied hostname of the meeting web app (through the existing tunnel).
PUBLIC_URL=https://CHANGE_ME_MEET_HOST
# The DNS-only (grey cloud) hostname of the TURN server. Same value in TURN_HOST and TURNS_HOST.
TURN_HOST=CHANGE_ME_TURN_HOST
TURNS_HOST=CHANGE_ME_TURN_HOST
# The VPS's public IPv4 address. The JVB tells every participant to send media here (UDP 10000), and coturn listens on it.
JVB_ADVERTISE_IPS=CHANGE_ME_PUBLIC_IP
PUBLIC_IP=CHANGE_ME_PUBLIC_IP

# ---------------------------------------------------------------- web: loopback only, TLS ends at Cloudflare
HTTP_PORT=127.0.0.1:8000
HTTPS_PORT=127.0.0.1:8443
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
ENABLE_HSTS=0
ENABLE_IPV6=0

# ---------------------------------------------------------------- authentication: tokens only
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
JWT_APP_ID=edulabs
JWT_ACCEPTED_ISSUERS=edulabs
JWT_ACCEPTED_AUDIENCES=edulabs
JWT_ALLOW_EMPTY=0
# Moderator comes from the token: context.user.moderator=true (teachers and assistants) makes the person a room owner,
# anyone else with a token is a plain member (prosody plugin mod_token_affiliation, shipped in the prosody image).
XMPP_MUC_MODULES=token_affiliation
# Nobody becomes moderator just by being first, or by being the last one left.
ENABLE_AUTO_OWNER=0
WAIT_FOR_HOST_DISABLE_AUTO_OWNERS=1
# A moderator cannot hand moderator rights to a student.
DISABLE_GRANT_MODERATOR=1
# No lobby (owner decision). "Students wait for the teacher" is enforced by EduLabs: a student gets no token at all until a
# teacher or assistant has pressed Start class for that session.
ENABLE_LOBBY=0
ENABLE_BREAKOUT_ROOMS=0
MAX_PARTICIPANTS=40

# ---------------------------------------------------------------- media
JVB_PORT=10000
# The public address is set above; do not ask a third-party STUN server for it.
JVB_DISABLE_STUN=true
# Always through the bridge (no peer-to-peer): students never learn each other's addresses, and 1:1 behaves like a class.
ENABLE_P2P=false
COLIBRI_REST_ENABLED=true
VIDEOBRIDGE_MAX_MEMORY=896m
JICOFO_MAX_MEMORY=320m
# TURN: prosody hands out short-lived credentials signed with TURN_CREDENTIALS (coturn use-auth-secret, same secret).
TURN_PORT=3478
TURN_TRANSPORT=udp
TURNS_PORT=443

# ---------------------------------------------------------------- what the class looks like
# Phones stay in the browser: never push the mobile app.
DISABLE_DEEP_LINKING=true
# EduLabs is the pre-join step (name from the token, muted, camera off), so Jitsi's own pre-join page is off.
ENABLE_PREJOIN_PAGE=false
ENABLE_WELCOME_PAGE=false
ENABLE_CLOSE_PAGE=false
# Everyone after the first participant (the teacher) starts muted and with the camera off. EduLabs also asks for this per
# person when it opens the class (students muted, camera off).
START_AUDIO_MUTED=1
START_VIDEO_MUTED=1
DEFAULT_LANGUAGE=en
ENABLE_CALENDAR=false
ENABLE_THIRD_PARTY_REQUESTS=false
DISABLE_PROFILE=true
# Whiteboard (Excalidraw backend in its own container). The web container proxies /socket.io/ to it, so the public URL is
# the meet host itself; no extra hostname or port.
WHITEBOARD_COLLAB_SERVER_URL_BASE=http://whiteboard.meet.jitsi
# Local recording only: the teacher's own browser records and saves the file on her computer. No server recording.
ENABLE_RECORDING=0
ENABLE_SERVICE_RECORDING=0
ENABLE_LIVESTREAMING=0
ENABLE_TRANSCRIPTIONS=0
DISABLE_LOCAL_RECORDING=false
# Upstream maps this to localRecording.disableSelfRecording=true: only moderators can record.
ENABLE_LOCAL_RECORDING_SELF_START=true
# Everyone in the class is told when the teacher starts recording (recommended; see the owner questions in ONLINE_CLASS_AUDIT.md).
ENABLE_LOCAL_RECORDING_NOTIFY_ALL_PARTICIPANT=true
TOOLBAR_BUTTONS=microphone,camera,desktop,whiteboard,chat,raisehand,participants-pane,tileview,fullscreen,recording,settings,hangup
# Only the EduLabs site may frame the meeting page. CHANGE_ME: the EduLabs app origin, e.g. https://app.example.com
CSP_HEADER=frame-ancestors CHANGE_ME_APP_ORIGIN

# ---------------------------------------------------------------- secrets (generated on the server; runbook step 4)
JWT_APP_SECRET=
TURN_CREDENTIALS=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
# Not used (no Jigasi, no Jibri) but filled so a stray service can never start with an empty password.
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
