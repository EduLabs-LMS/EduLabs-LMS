APP_ORIGIN=https://staging.edulabs-eg.com
# Public values are recovered from the image's build manifest. Supplying
# conflicting public settings at runtime makes the process fail closed.
# Optional browser push advertisement only (private key belongs to worker).
PUSH_VAPID_PUBLIC_KEY=

# Branded Firebase auth email delivery (server-side only; set through protected runtime env).
BREVO_API_KEY=
AUTH_EMAIL_FROM=EduLabs <no-reply@mail.edulabs-eg.com>
# Durable external rate-limit gateway; endpoints fail closed when unset.
AUTH_EMAIL_RATE_LIMIT_URL=
AUTH_EMAIL_RATE_LIMIT_TOKEN=
