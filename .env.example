# Supabase browser/server clients use only these public credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Legacy portal remains on Clerk/Prisma until the explicit auth/data cutover.
LMS_DATA_BACKEND=legacy
# Rebuild after changing this public flag. Keep Clerk as the default.
NEXT_PUBLIC_AUTH_BACKEND=clerk
# Firebase staging requires LMS_DATA_BACKEND=supabase-staging as well.
# Firebase Admin runs in a trusted Node backend; production requires HTTPS.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAbDz3MExjKIjNgJ7_sZJ8whg_9o8zg1Ic
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=diagonproduction.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=diagonproduction
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=diagonproduction.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=763224541949
NEXT_PUBLIC_FIREBASE_APP_ID=1:763224541949:web:9b42bff679736390a04c94
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-QGN2HJVSCG
# Exact browser origin. Required in production, e.g. http://localhost:3000 locally.
APP_ORIGIN=http://localhost:3000
# Trusted Node backend only. Prefer GOOGLE_APPLICATION_CREDENTIALS pointing to
# a protected file OUTSIDE this repo, or workload identity / ADC on your host.
# Alternatively configure both via a secrets manager, never NEXT_PUBLIC_:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional Web Push. Only the public VAPID key is returned to authenticated browsers.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
# Trusted dispatcher process only; never NEXT_PUBLIC_, never put in client code.
NOTIFICATION_WORKER_PROJECT_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy email transport, configured server-side; Firebase support uses persisted tickets.
SUPPORT_EMAIL_FROM=
SUPPORT_EMAIL_TO=

# Keep disabled until the Apple Developer/Firebase setup and acceptance gates pass.
NEXT_PUBLIC_FIREBASE_APPLE_ENABLED=false

# Anonymous teacher websites: requires an external durable gateway; missing enforcement fails closed.
PUBLIC_WEBSITE_RATE_LIMIT_URL=
PUBLIC_WEBSITE_RATE_LIMIT_TOKEN=
# Optional exact extra platform ingress authorities (not teacher custom-domain bindings).
PUBLIC_WEBSITE_ALLOWED_HOSTS=

# Branded Firebase staging authentication emails (server only; never NEXT_PUBLIC_).
RESEND_API_KEY=
AUTH_EMAIL_FROM=EduLabs <no-reply@mail.edulabs-eg.com>
# Exact HTTPS origin used for branded email action links.
# On private staging use https://staging.edulabs-eg.com; production must use the final first-party origin.
# Durable external rate-limit gateway must be configured before enabling these endpoints.
AUTH_EMAIL_RATE_LIMIT_URL=
AUTH_EMAIL_RATE_LIMIT_TOKEN=
