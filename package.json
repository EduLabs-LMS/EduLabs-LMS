{
	"name": "learning-management-system",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "node --require ./scripts/windows-filesystem.cjs ./node_modules/next/dist/bin/next dev -H localhost -p 3000",
		"build": "npm run check:boundaries && node --require ./scripts/windows-filesystem.cjs ./node_modules/next/dist/bin/next build",
		"start": "node --require ./scripts/windows-filesystem.cjs ./node_modules/next/dist/bin/next start",
		"lint": "eslint app frontend server shared --ext .ts,.tsx",
		"typecheck": "tsc --noEmit",
		"check:boundaries": "node scripts/check-boundaries.cjs",
		"test:architecture": "node --test scripts/check-boundaries.test.cjs",
		"test:lms-http": "node scripts/lms-http-security.cjs",
		"test:lms-load": "node scripts/lms-load-test.cjs",
		"db:legacy-inspect": "node scripts/legacy-migration.cjs --inspect",
		"test": "node --test scripts/check-boundaries.test.cjs scripts/backend.test.cjs scripts/countdown.test.cjs scripts/windows-filesystem.test.cjs scripts/lms.test.cjs scripts/legacy-migration.test.cjs scripts/dependency-security.test.cjs scripts/firebase-auth.test.cjs scripts/account.test.cjs scripts/academics.test.cjs scripts/website.test.cjs scripts/teacher-course.test.cjs scripts/v2-transplant.test.cjs scripts/platform-branding.test.cjs scripts/student-portal.test.cjs scripts/exams-foundation.test.cjs scripts/exam-security.test.cjs scripts/exam-runner.test.cjs scripts/lessons.test.cjs scripts/homework.test.cjs scripts/groups.test.cjs scripts/group-presentation.test.cjs scripts/communications.test.cjs scripts/student-administration.test.cjs scripts/signup-recovery.test.cjs scripts/deployment.test.cjs scripts/milestone1.test.cjs scripts/lesson-covers.test.cjs scripts/chapter-metadata.test.cjs",
		"check": "npm test && npm run check:boundaries && npm run typecheck && npm run lint",
		"postinstall": "prisma generate",
		"test:exam-sql": "node scripts/exam-sql-local.cjs",
		"test:exam-sql:postgres": "node scripts/exam-sql-local.cjs --postgres",
		"test:security-smoke": "node scripts/security-smoke.cjs",
		"test:firebase": "node --test scripts/firebase-auth.test.cjs scripts/website.test.cjs scripts/teacher-course.test.cjs",
		"test:firebase-public": "node scripts/firebase-public-smoke.cjs",
		"test:firebase-tenant": "node scripts/firebase-tenant-http.cjs",
		"db:auth-plan": "node scripts/auth-migration-plan.cjs",
		"db:firebase-sql": "node scripts/firebase-sql-suite.cjs",
		"notifications:dispatch": "node scripts/notification-dispatch.cjs"
	},
	"dependencies": {
		"@clerk/backend": "3.23.2",
		"@clerk/nextjs": "7.9.14",
		"@hello-pangea/dnd": "16.3.0",
		"@hookform/resolvers": "3.3.1",
		"@livekit/components-react": "1.4.0",
		"@livekit/components-styles": "1.0.7",
		"@mux/mux-node": "7.3.2",
		"@mux/mux-player-react": "2.0.1",
		"@prisma/client": "5.22.0",
		"@radix-ui/react-alert-dialog": "1.0.5",
		"@radix-ui/react-checkbox": "1.0.4",
		"@radix-ui/react-dialog": "1.0.5",
		"@radix-ui/react-dropdown-menu": "2.0.6",
		"@radix-ui/react-label": "2.0.2",
		"@radix-ui/react-popover": "1.0.7",
		"@radix-ui/react-progress": "1.0.3",
		"@radix-ui/react-separator": "1.0.3",
		"@radix-ui/react-slot": "1.0.2",
		"@radix-ui/react-tooltip": "1.0.7",
		"@supabase/ssr": "0.12.7",
		"@supabase/supabase-js": "2.117.2",
		"@tanstack/react-table": "8.10.7",
		"@uploadthing/react": "7.3.3",
		"axios": "1.20.0",
		"class-variance-authority": "0.7.0",
		"clsx": "2.0.0",
		"cmdk": "0.2.0",
		"firebase": "13.0.0",
		"firebase-admin": "14.5.0",
		"framer-motion": "13.4.6",
		"livekit-client": "1.14.4",
		"livekit-server-sdk": "1.2.7",
		"lucide-react": "0.284.0",
		"next": "15.5.27",
		"next-themes": "0.2.1",
		"pdf-lib": "1.17.1",
		"pdfjs-dist": "6.4.299",
		"query-string": "9.5.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-facebook": "9.0.12",
		"react-hook-form": "7.47.0",
		"react-hot-toast": "2.4.1",
		"react-icons": "4.11.0",
		"react-quill-new": "3.8.3",
		"recharts": "2.9.0",
		"resend": "6.31.0",
		"server-only": "0.0.1",
		"sharp": "0.35.5",
		"tailwind-merge": "1.14.0",
		"uploadthing": "7.7.4",
		"web-push": "3.6.7",
		"zod": "3.22.4",
		"zustand": "4.4.4"
	},
	"overrides": {
		"postcss": "$postcss",
		"postcss-selector-parser": "7.1.6",
		"effect": "3.22.2",
		"@grpc/grpc-js": "1.14.6"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"devDependencies": {
		"@next/env": "15.5.27",
		"@types/node": "20.8.2",
		"@types/react": "18.2.25",
		"@types/react-dom": "18.2.10",
		"autoprefixer": "10.4.16",
		"eslint": "8.57.1",
		"eslint-config-next": "15.5.27",
		"postcss": "8.5.29",
		"prisma": "5.22.0",
		"tailwindcss": "3.3.3",
		"tailwindcss-animate": "1.0.7",
		"typescript": "5.2.2"
	}
}
